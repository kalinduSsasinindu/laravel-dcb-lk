{
    "name": "kalindussasinindu/laravel-dcb-lk",
    "description": "Direct Carrier Billing for Sri Lanka (Ideamart & mSpace) - OTP subscription verification, status polling, and webhooks, behind one driver interface.",
    "keywords": [
        "laravel",
        "sri lanka",
        "carrier billing",
        "dcb",
        "ideamart",
        "mspace",
        "hsenid",
        "otp",
        "subscription"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kalindu Sasinindu",
            "email": "kalindusasinindu153@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "DcbLk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DcbLk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DcbLk\\DcbLkServiceProvider"
            ],
            "aliases": {
                "DcbLk": "DcbLk\\Facades\\DcbLk"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
